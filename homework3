import random

SIZE = 5
TYPES = ["пусто", "сундук", "монстр", "ловушка", "портал"]
LOOT = ["золото", "зелье", "меч", "щит"]
ICONS = {
    "пусто": ".",
    "сундук": "C",
    "монстр": "M",
    "ловушка": "!",
    "портал": "O",
    "ключ": "K",
    "старт": "S",
    "выход": "E"
}


def create_maze():
    maze = []

    for x in range(SIZE):
        row = []
        for y in range(SIZE):
            room = {"type": random.choice(TYPES), "visited": False}
            row.append(room)
        maze.append(row)

    maze[0][0]["type"] = "старт"
    maze[SIZE - 1][SIZE - 1]["type"] = "выход"

    while True:
        x = random.randrange(SIZE)
        y = random.randrange(SIZE)
        if (x, y) != (0, 0) and (x, y) != (SIZE - 1, SIZE - 1):
            maze[x][y]["type"] = "ключ"
            break

    return maze


def show_map(maze, state):
    for x in range(SIZE):
        line = []

        for y in range(SIZE):
            room = maze[x][y]

            if x == state["x"] and y == state["y"]:
                line.append("@")
            elif room["visited"]:
                line.append(ICONS[room["type"]])
            else:
                line.append("?")

        print(" ".join(line))


def use_potion(state):
    if "зелье" in state["inv"]:
        state["inv"].remove("зелье")
        state["hp"] = min(100, state["hp"] + 30)
        print("Вы выпили зелье. HP:", state["hp"])
    else:
        print("У вас нет зелья!")


def fight(state):
    monster_hp = random.randint(20, 35)

    while monster_hp > 0 and state["hp"] > 0:
        print("Монстр:", monster_hp, "HP. Вы:", state["hp"], "HP")
        action = input("1 — ударить, 2 — зелье, 3 — бежать: ")

        if action == "1":
            damage = random.randint(5, 15)
            if "меч" in state["inv"]:
                damage += 5

            monster_hp -= damage
            print("Вы нанесли урон:", damage)

        elif action == "2":
            use_potion(state)

        elif action == "3":
            if random.random() < 0.5:
                print("Вы сбежали!")
                return

            print("Сбежать не удалось!")

        else:
            print("Неизвестная команда")
            continue

        if monster_hp > 0:
            damage = random.randint(5, 12)
            if "щит" in state["inv"]:
                damage //= 2

            state["hp"] -= damage
            print("Монстр нанёс урон:", damage)

    if state["hp"] > 0:
        state["inv"].append("золото")
        print("Монстр побеждён! Вы получили золото.")


def enter_room(maze, state):
    room = maze[state["x"]][state["y"]]

    if room["visited"]:
        return

    room["visited"] = True
    kind = room["type"]
    print("Вы вошли в комнату:", kind)

    if kind == "сундук":
        item = random.choice(LOOT)
        state["inv"].append(item)
        print("Вы нашли:", item)

    elif kind == "ключ":
        state["inv"].append("ключ")
        print("Теперь вы можете открыть выход!")

    elif kind == "ловушка":
        damage = random.randint(10, 25)
        if "щит" in state["inv"]:
            damage //= 2

        state["hp"] -= damage
        print("Ловушка! Получен урон:", damage)

    elif kind == "монстр":
        fight(state)

    elif kind == "портал":
        state["x"] = random.randrange(SIZE)
        state["y"] = random.randrange(SIZE)
        print("Портал перенёс вас в другую комнату!")
        enter_room(maze, state)


def inventory_menu(state):
    while True:
        print("Инвентарь:", state["inv"])
        command = input("1 — сортировать, 2 — зелье, 0 — назад: ")

        if command == "1":
            state["inv"].sort()
        elif command == "2":
            use_potion(state)
        elif command == "0":
            return
        else:
            print("Неизвестная команда")


def main():
    maze = create_maze()
    state = {"hp": 100, "inv": [], "x": 0, "y": 0}
    moves = {
        "w": (-1, 0),
        "s": (1, 0),
        "a": (0, -1),
        "d": (0, 1)
    }

    while state["hp"] > 0:
        enter_room(maze, state)

        if state["hp"] <= 0:
            break

        show_map(maze, state)
        print("HP:", state["hp"])

        if state["x"] == SIZE - 1 and state["y"] == SIZE - 1:
            if "ключ" in state["inv"]:
                print("Вы открыли выход. Победа!")
                return

            print("Выход закрыт. Найдите ключ!")

        command = input(
            "w/a/s/d — идти, i — инвентарь, q — выйти: "
        ).lower()

        if command == "q":
            return

        elif command == "i":
            inventory_menu(state)

        elif command in moves:
            dx, dy = moves[command]
            nx = state["x"] + dx
            ny = state["y"] + dy

            if 0 <= nx < SIZE and 0 <= ny < SIZE:
                state["x"] = nx
                state["y"] = ny
            else:
                print("Там стена!")

        else:
            print("Неизвестная команда")

    print("Ваше здоровье закончилось. Вы проиграли!")


if __name__ == "__main__":
    main()
